# Root .gitignore for the project

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files (do NOT commit real credentials)
.env
.env.*
*.env

# Node
node_modules/

# Distribution / packaging
build/
dist/
*.egg-info/

# IDEs and editors
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs and coverage
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml

# SQLite
*.sqlite3
